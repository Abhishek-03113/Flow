{
  "name": "flow-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check . ../../design-system",
    "format": "prettier --write . ../../design-system",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "format:check": "prettier --check . ../../design-system",
    "tauri": "tauri"
  },
  "dependencies": {
    "@flow/design-system": "file:../../design-system",
    "@tauri-apps/api": "2.12.2",
    "lucide-react": "1.54.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
