{
  // Used by `npm run typecheck`. Adds the design-system source (resolving react/lucide from this app).
  // Kept separate because Playwright reads tsconfig.json and must not see the catch-all `paths`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "*": ["./node_modules/@types/*", "./node_modules/*"] }
  },
  "include": [
    "src",
    "e2e",
    "e2e-live",
    "playwright.live.config.ts",
    "../../design-system/src",
    "../../design-system/gallery",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
